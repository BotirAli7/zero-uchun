; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited.
;
; Format:
;   [section] ; section goes as a header
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[]
_global_script_class_icons={}

[application]

config/name="Kestrel City"
run/main_scene="res://scenes/Haven.tscn"
config/use_custom_user_dir=false

[autoload]

GameState="*res://scripts/GameState.gd"
NoiseManager="*res://scripts/NoiseManager.gd"

[display]

window/size/width=1024
window/size/height=600
window/stretch/mode="2d"
window/stretch/aspect="keep"
